# =========================================
# Streamlit Secrets — DO NOT COMMIT ไป Git!
# =========================================
# วางค่าจริงใน Streamlit Cloud → App Settings → Secrets
# ตอน dev local: cp secrets.toml.example secrets.toml + ใส่ค่าจริง
#
# ค่าเหล่านี้เข้าถึงได้ใน code ผ่าน st.secrets["r2"]["access_key_id"] เป็นต้น

[r2]
access_key_id     = "REPLACE_WITH_YOUR_ACCESS_KEY"
secret_access_key = "REPLACE_WITH_YOUR_SECRET_KEY"
endpoint_url      = "https://YOUR_ACCOUNT.r2.cloudflarestorage.com"
bucket            = "wanwanach-data"
region            = "auto"

# ─── First-run admin seed (used only when R2 users.json is empty) ───
# สร้าง bcrypt hash: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
[seed_admin]
username      = "admin"
password_hash = "REPLACE_WITH_BCRYPT_HASH"
name          = "ผู้ดูแลระบบ"
email         = "admin@example.com"
